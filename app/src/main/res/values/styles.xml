<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@style/Theme.AppCompat.Light.NoActionBar" />

    <style name="ApplicationTheme" parent="AppTheme">
        <item name="android:windowSplashScreenBackground">@color/splash_color</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
        <!--<item name="android:windowSplashScreenAnimatedIcon">@drawable/app_launch_anim</item>-->
<!--        <item name="android:windowBackground">@mipmap/ic_launcher</item>-->
<!--        <item name="android:windowDisablePreview">true</item>-->
    </style>

    <style name="PopupItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#333333</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="LaunchTheme" parent="AppTheme">
        <item name="android:windowSplashScreenBackground">@color/splash_color</item>
<!--        <item name="android:windowBackground">@mipmap/ic_launcher</item>-->
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <!--&lt;!&ndash; 关闭系统强制深色模式 &ndash;&gt;
        <item name="android:forceDarkAllowed">false</item>
        &lt;!&ndash; 全屏，无标题栏 &ndash;&gt;
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>

        &lt;!&ndash; 隐藏 状态栏 / 通知栏 &ndash;&gt;
        <item name="android:windowFullscreen">true</item>

        &lt;!&ndash; 延伸内容到状态栏区域 &ndash;&gt;
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        &lt;!&ndash; 保持屏幕常亮（TV专用） &ndash;&gt;
        <item name="android:keepScreenOn">true</item>-->
    </style>

</resources>